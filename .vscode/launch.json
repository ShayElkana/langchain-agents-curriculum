{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (.env)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Step 1: Simple LLM Call",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/steps/step1_simple_llm_call.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Step 1: Chat REPL Exercise",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/steps/step1_exercise_chat_repl.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
